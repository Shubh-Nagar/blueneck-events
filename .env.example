# Optional: a form endpoint (Formspree, Getform, your own API) that accepts JSON POSTs.
# When set, the contact form posts here. Otherwise it opens the visitor's email app
# addressed to the email in src/data/site.ts.
VITE_FORM_ENDPOINT=

# Website assistant (chat widget, bottom-right).
# On Vercel, set ANTHROPIC_API_KEY in Project → Settings → Environment Variables (server-side
# only, never prefix it with VITE_) and the widget answers with Claude via /api/chat.
# Without it, or on hosts that don't run /api (Netlify static, Hostinger), the widget answers
# from the site's own data instead. Set VITE_ASSISTANT_ENDPOINT to point at a different
# endpoint, or to an empty value to always use the built-in answers.
# ANTHROPIC_API_KEY=
# VITE_ASSISTANT_ENDPOINT=/api/chat
